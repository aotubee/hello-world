<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edc.erp.common.mapper.GoodsCombinationMapper">
    
    <!-- 结果集 -->
    <resultMap  id="resultMap" type="com.edc.erp.common.entity.GoodsCombination">
        <result property="id" column="id" jdbcType="BIGINT"/>
        <result property="combinationTypeCode" column="combination_type_code" jdbcType="VARCHAR"/>
        <result property="combinationValue" column="combination_value" jdbcType="VARCHAR"/>
        <result property="orderTypeConfigId" column="order_type_config_id" jdbcType="BIGINT"/>
        <result property="orgCode" column="org_code" jdbcType="VARCHAR"/>
        <result property="bizOrgCode" column="biz_org_code" jdbcType="VARCHAR"/>
        <result property="goodsType" column="goods_type" jdbcType="VARCHAR"/>
        <result property="creator" column="creator" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updater" column="updater" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="isDelete" column="is_delete" jdbcType="INTEGER"/>
    </resultMap>
  
    <!-- 所有字段 -->
    <sql id="Base_Column_List">
       id, combination_type_code, combination_value, order_type_config_id, org_code, biz_org_code, goods_type, creator, create_time, updater, update_time, is_delete    
    </sql>
    
     <!-- 查询条件 -->
     <sql id="Base_Where_Clause">
            <where>
                    <if test="id != null">
                    and id = #{id}
                </if>
                    <if test="combinationTypeCode != null and combinationTypeCode != ''">
                    and combination_type_code = #{combinationTypeCode}
                </if>
                    <if test="combinationValue != null and combinationValue != ''">
                    and combination_value = #{combinationValue}
                </if>
                    <if test="orderTypeConfigId != null">
                    and order_type_config_id = #{orderTypeConfigId}
                </if>
                    <if test="orgCode != null and orgCode != ''">
                    and org_code = #{orgCode}
                </if>
                    <if test="bizOrgCode != null and bizOrgCode != ''">
                    and biz_org_code = #{bizOrgCode}
                </if>
                    <if test="goodsType != null and goodsType != ''">
                    and goods_type = #{goodsType}
                </if>
                    <if test="creator != null and creator != ''">
                    and creator = #{creator}
                </if>
                    <if test="createTime != null">
                    and create_time = #{createTime}
                </if>
                    <if test="updater != null and updater != ''">
                    and updater = #{updater}
                </if>
                    <if test="updateTime != null">
                    and update_time = #{updateTime}
                </if>
                    <if test="isDelete != null">
                    and is_delete = #{isDelete}
                </if>
                </where>
     </sql>

    <select id="findByOrgCodeAndOrderTypeConfigIdList" resultMap="resultMap">
        select <include refid="Base_Column_List"/>
        from opt_goods_combination
        where biz_org_code = #{bizOrgCode,jdbcType=VARCHAR}
        and order_type_config_id in
        <foreach collection="orderTypeConfigIdList" item="configId" separator="," open="(" close=")">
            #{configId,jdbcType=INTEGER}
        </foreach>
        and is_delete = 0
    </select>
</mapper>
