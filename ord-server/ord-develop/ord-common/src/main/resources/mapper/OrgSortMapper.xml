<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edc.erp.common.mapper.OrgSortMapper">

  <sql id="Base_Column_List">
    id,sort,sort_name,sort_manager,sort_standard,parent_sort_code,org_code, biz_org_code, goods_type, creator,create_time,updater,update_time,is_delete,max_item_num,is_show
  </sql>
  <select id="findSortListByBizOrgCode" resultType="com.edc.erp.common.model.out.goods.GoodsSortOut">
    select <include refid="Base_Column_List"/> from gc_org_sort where biz_org_code = #{bizOrgCode} and is_delete = 0 order by sort
  </select>


</mapper>