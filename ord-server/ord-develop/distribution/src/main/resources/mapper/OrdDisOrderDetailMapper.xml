                </if>
                <if test="invoiceType != null and invoiceType != ''">
                    and invoice_type = #{invoiceType}
                </if>
                </where>
     </sql>

    <select id="findOrderDetailOutByPage" resultType="com.edc.erp.distribution.model.out.OrderDetailOut">
        select id, order_id, goods_code, goods_name, bar_code, small_sort, tag_name, specification_unit,
        distribution_specification, distribution_specification_num, distribution_specification_unit,
        position, distribution_type, quantity, package_quantity, order_unit_price, order_amount, original_price,
        origina_amount, activity_unit_price, activity_no, suggested_retail_price, is_activity, is_gift,
        allow_distribution_return, creator, create_time, updater, update_time, is_delete, goods_type,
        real_unit_price, real_amount, base_goods_code, activity_type,invoice_type,
        case when base_goods_code is null then goods_code
        else concat(base_goods_code,goods_code)
        end as sort
        from ord_dis_order_detail
        <where>
            <if test="orderDetailIn.orderId != null">
                and order_id = #{orderDetailIn.orderId}
            </if>
            <if test="orderDetailIn.goodsCode != null and orderDetailIn.goodsCode != ''">
                and goods_code = #{orderDetailIn.goodsCode}
            </if>
            <if test="orderDetailIn.goodsName != null and orderDetailIn.goodsName != ''">
                and goods_name like concat ('%', #{orderDetailIn.goodsName}, '%')
            </if>
        </where>
        order by sort
    </select>

    <select id="sumExistsTotalPackageQuantityBySkuCodeAndOrderIdList" resultType="java.math.BigDecimal">
        select sum(package_quantity) from ord_dis_order_detail where goods_code = #{skuCode} and order_id in
        <foreach collection="orderIdList" separator="," open="(" close=")" item="item">
            #{item}
        </foreach>
        and is_delete = 0
    </select>
    <select id="findTopOrderDetailListByOrderId"
            resultType="com.edc.erp.distribution.model.out.AppTopDisOrderGoodsOut">
        select goods_name,goods_image from ord_dis_order_detail where order_id = #{orderId} and is_delete = 0 and is_gift = 0
        order by id desc limit #{topNum}
    </select>
    <select id="getCycleOrderedGoodsQty" resultType="java.math.BigDecimal">
        select ifnull(sum(quantity), 0)
        from ord_dis_order_detail odod
        inner join  ord_dis_order odo on odod.order_id = odo.id and odo.is_delete = 0
        where odo.order_status_code != 'invalid' and odo.order_cycle_id = #{orderCycleId}
            and odo.source_code in ('manual','upLowDown')
            and odod.goods_code = #{goodsCode} and odod.is_gift = 0  and odod.is_delete = 0
    </select>
    <select id="batchSaveDisOrderDetail">
        insert into ord_dis_order_detail
        (order_id, goods_code, goods_name,goods_image, bar_code, small_sort, tag_name, specification_unit, distribution_specification,
        distribution_specification_num, distribution_specification_unit, position, distribution_type, quantity, package_quantity, order_unit_price,
        order_amount, original_price, origina_amount, activity_unit_price, activity_no, suggested_retail_price, is_activity, is_gift, allow_distribution_return,
        creator, create_time, updater, update_time, is_delete, goods_type, real_unit_price, real_amount, base_goods_code, activity_type,invoice_type
        )
        values
        <foreach collection="ordDisOrderDetailList" item="item" separator=",">
            (#{item.orderId},#{item.goodsCode},#{item.goodsName},#{item.goodsImage},#{item.barCode},#{item.smallSort},
            #{item.tagName},#{item.specificationUnit},#{item.distributionSpecification},
            #{item.distributionSpecificationNum},#{item.distributionSpecificationUnit},#{item.position},#{item.distributionType},#{item.quantity},#{item.packageQuantity},
            #{item.orderUnitPrice},#{item.orderAmount},#{item.originalPrice},#{item.originaAmount},#{item.activityUnitPrice},#{item.activityNo},#{item.suggestedRetailPrice},
            #{item.isActivity},#{item.isGift},#{item.allowDistributionReturn},#{item.creator},#{item.createTime},#{item.updater},
            #{item.updateTime},#{item.isDelete},#{item.goodsType},#{item.realUnitPrice},#{item.realAmount},#{item.baseGoodsCode},#{item.activityType},#{item.invoiceType})
        </foreach>
    </select>


</mapper>
