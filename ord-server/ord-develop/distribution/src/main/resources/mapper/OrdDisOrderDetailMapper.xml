                    and real_unit_price = #{realUnitPrice}
                </if>
                    <if test="realAmount != null">
                    and real_amount = #{realAmount}
                </if>
                <if test="baseGoodsCode != null and baseGoodsCode != ''">
                    and base_goods_code = #{baseGoodsCode}
                </if>
