<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edc.erp.presale.mapper.OrdDisPresaleAdjustOrderMapper">
    <resultMap id="BaseResultMap" type="com.edc.erp.presale.entity.OrdDisPresaleAdjustOrder">
        <result column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="status" property="status"/>
        <result column="store_code" property="storeCode"/>
        <result column="store_name" property="storeName"/>
        <result column="total_sku_qty" property="totalSkuQty"/>
        <result column="adjust_qty" property="adjustQty"/>
        <result column="adjust_type" property="adjustType"/>
        <result column="is_charge_order" property="isChargeOrder"/>
        <result column="is_charge" property="isCharge"/>
        <result column="source_no" property="sourceNo"/>
        <result column="approver" property="approver"/>
        <result column="approval_time" property="approvalTime"/>
        <result column="creator" property="creator"/>
        <result column="org_code" property="orgCode"/>
        <result column="biz_org_code" property="bizOrgCode"/>
        <result column="create_time" property="createTime"/>
        <result column="updater" property="updater"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_delete" property="isDelete"/>
        <result column="remark" property="remark"/>
    </resultMap>
    <!-- 所有字段 -->
    <sql id="Base_Column_List">
        id, order_no, status, store_code, store_name, total_sku_qty, adjust_qty, adjust_type, is_charge_order,
        is_charge, source_no, approver,approval_time,creator,org_code,biz_org_code, create_time, updater, update_time,
        is_delete,
        remark
    </sql>
    <select id="findPresaleAdjustOrderByPage"
            resultType="com.edc.erp.presale.model.out.PresaleAdjustOrderPageOut">
        SELECT
        ao.id, ao.order_no, ao.status, ao.store_code, ao.store_name, ao.total_sku_qty, ao.adjust_qty, ao.adjust_type, ao.is_charge_order,
        ao.is_charge, ao.source_no, ao.approver,ao.approval_time,ao.creator,ao.org_code,ao.biz_org_code, ao.create_time, ao.updater, ao.update_time,
        ao.is_delete,
        ao.remark
        FROM ord_dis_presale_adjust_order ao
        where ao.is_delete = 0
        <if test="storeCode != null and storeCode != ''">
            and ao.store_code = #{storeCode}
        </if>
        <if test="goodsCode != null and goodsCode != ''">
            and exists (select 1 from ord_dis_presale_adjust_order_detail aod where aod.goods_code = #{goodsCode} and
            aod.adjust_order_id = ao.id)
        </if>
        <if test="bizOrgCode != null and bizOrgCode != ''">
            and ao.biz_org_code = #{bizOrgCode}
        </if>
        <if test="status != null and status != ''">
            and ao.status = #{status}
        </if>
        <if test="orderNo != null and orderNo != ''">
            and ao.order_no = #{orderNo}
        </if>
        <if test="startTime != null and startTime != ''">
            and ao.create_time <![CDATA[>=]]> #{startTime}
        </if>
        <if test="endTime != null and endTime != ''">
            and ao.create_time <![CDATA[<=]]> #{endTime}
        </if>
        <if test="adjustType != null and adjustType != ''">
            and ao.adjust_type = #{adjustType}
        </if>
        <if test="isChargeOrder != null and isChargeOrder != ''">
            and ao.is_charge_order = #{isChargeOrder}
        </if>
        <if test="isCharge != null and isCharge != ''">
            and ao.is_charge = #{isCharge}
        </if>
        <if test="approvalStartTime != null and approvalStartTime != ''">
            and ao.approval_time <![CDATA[>=]]> #{approvalStartTime}
        </if>
        <if test="approvalEndTime != null and approvalEndTime != ''">
            and ao.approval_time <![CDATA[<=]]> #{approvalEndTime}
        </if>
        <if test="storeCodeList != null and storeCodeList.size() > 0">
            and ao.store_code in
            <foreach collection="storeCodeList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        order by ao.create_time desc
    </select>
</mapper>
